---
// A homework problem from the original course (Math 2001, Fall 2024): the author's material,
// shown with its source like a book excerpt.
interface Props {
  homework: number
  problem: number
}

const { homework, problem } = Astro.props
const wiki = `https://github.com/hrmacbeth/math2001/wiki/Homework-${homework}`
---

<p class="book-source">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
  <span>From <a href={wiki} target="_blank" rel="noopener">Homework {homework}</a>, Math 2001 (Fall 2024), by Heather Macbeth</span>
</p>
<div class="book-excerpt homework-problem">
  <p class="homework-label">Problem {problem}</p>
  <slot />
</div>
